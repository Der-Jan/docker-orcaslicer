# syntax=docker/dockerfile:1

FROM ghcr.io/linuxserver/baseimage-selkies:arm64v8-debiantrixie

# set version label
ARG BUILD_DATE
ARG VERSION
ARG ORCASLICER_VERSION
ARG SUPPORT_FINS_VERSION
LABEL build_version="Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}"
LABEL maintainer="thelamer"

# title
ENV TITLE=OrcaSlicer \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PIXELFLUX_WAYLAND=true

# build sources
COPY tools/wayland-file-drop/build.sh \
  tools/wayland-file-drop/drop.c \
  tools/wayland-file-drop/layer-shell.xml \
  tools/wayland-file-drop/virtual-pointer.xml \
  tools/wayland-file-drop/watch-desktop.py \
  tools/wayland-file-drop/xdg-shell.xml /build/wayland-file-drop/

RUN \
  echo "**** add icon ****" && \
  curl -o \
    /usr/share/selkies/www/icon.png \
    https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/orcaslicer-logo.png && \
  echo "**** add mozilla apt repo ****" && \
  install -d -m 0755 /etc/apt/keyrings && \
  curl -o \
    /etc/apt/keyrings/packages.mozilla.org.asc -L \
    https://packages.mozilla.org/apt/repo-signing-key.gpg && \
  echo \
    "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main" > \
    /etc/apt/sources.list.d/mozilla.list && \
  printf \
    "Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n" > \
    /etc/apt/preferences.d/mozilla && \
  apt-get update && \
  echo "**** install build dependencies ****" && \
  apt-get install --no-install-recommends -y \
    libwayland-dev \
    pkg-config && \
  echo "**** build wayland file drop helper ****" && \
  sh /build/wayland-file-drop/build.sh && \
  install -Dm755 /build/wayland-file-drop/wayland-file-drop /usr/local/libexec/wayland-file-drop && \
  install -m644 /build/wayland-file-drop/watch-desktop.py /usr/local/libexec/watch-desktop.py && \
  rm -rf /build/wayland-file-drop && \
  echo "**** remove build dependencies ****" && \
  apt-get purge -y \
    libwayland-dev \
    pkg-config && \
  echo "**** install packages ****" && \
  DEBIAN_FRONTEND=noninteractive \
  apt-get install --no-install-recommends -y \
    firefox \
    gstreamer1.0-alsa \
    gstreamer1.0-gl \
    gstreamer1.0-gtk3 \
    gstreamer1.0-libav \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-pulseaudio \
    gstreamer1.0-qt5 \
    gstreamer1.0-tools \
    gstreamer1.0-x \
    libgstreamer-plugins-bad1.0 \
    libmspack0 \
    libwebkit2gtk-4.1-0 \
    libwx-perl && \
  echo "**** install orcaslicer nightly from appimage ****" && \
  if [ -z ${ORCASLICER_VERSION+x} ]; then \
    ORCASLICER_VERSION=nightly-builds; \
  fi && \
  curl -fsSL "https://api.github.com/repos/OrcaSlicer/OrcaSlicer/releases/tags/${ORCASLICER_VERSION}" -o /tmp/orca-release.json && \
  DOWNLOAD_URL=$(jq -er 'first(.assets[] | select(.name == "OrcaSlicer_Linux_AppImage_Ubuntu2404_aarch64_nightly.AppImage") | .browser_download_url)' /tmp/orca-release.json) && \
  APPIMAGE_SHA256=$(jq -er 'first(.assets[] | select(.name == "OrcaSlicer_Linux_AppImage_Ubuntu2404_aarch64_nightly.AppImage") | .digest | select(startswith("sha256:")))' /tmp/orca-release.json) && \
  cd /tmp && \
  curl -fsSL "${DOWNLOAD_URL}" -o /tmp/orca.app && \
  printf "%s  orca.app\n" "${APPIMAGE_SHA256#sha256:}" | sha256sum -c - && \
  chmod +x /tmp/orca.app && \
  ./orca.app --appimage-extract && \
  mv squashfs-root /opt/orcaslicer && \
  chmod -R a+rX /opt/orcaslicer && \
  echo "**** install current rclone ****" && \
  RCLONE_VERSION=$(curl -fsSL https://downloads.rclone.org/version.txt | awk '{print $2}') && \
  curl -fsSL "https://downloads.rclone.org/${RCLONE_VERSION}/rclone-${RCLONE_VERSION}-linux-arm64.zip" -o "/tmp/rclone-${RCLONE_VERSION}-linux-arm64.zip" && \
  curl -fsSL "https://downloads.rclone.org/${RCLONE_VERSION}/SHA256SUMS" -o /tmp/rclone.sha256 && \
  cd /tmp && \
  sha256sum --check --ignore-missing /tmp/rclone.sha256 && \
  python3 -m zipfile -e "/tmp/rclone-${RCLONE_VERSION}-linux-arm64.zip" /tmp/rclone && \
  install -m755 "/tmp/rclone/rclone-${RCLONE_VERSION}-linux-arm64/rclone" /usr/local/bin/rclone && \
  echo "**** build support fins plugin ****" && \
  if [ -z ${SUPPORT_FINS_VERSION+x} ]; then \
    SUPPORT_FINS_VERSION=$(curl -fsSL "https://api.github.com/repos/gittrahan/support-fins/commits/main" | jq -er '.sha'); \
  fi && \
  mkdir -p /build/support-fins /build/esbuild && \
  curl -fsSL "https://github.com/gittrahan/support-fins/archive/${SUPPORT_FINS_VERSION}.tar.gz" -o /build/support-fins.tar.gz && \
  tar -xzf /build/support-fins.tar.gz --strip-components=1 -C /build/support-fins && \
  curl -fsSL "https://registry.npmjs.org/@esbuild/linux-arm64/-/linux-arm64-0.28.0.tgz" -o /build/esbuild.tar.gz && \
  tar -xzf /build/esbuild.tar.gz --strip-components=1 -C /build/esbuild && \
  ESBUILD=/build/esbuild/bin/esbuild python3 /build/support-fins/plugins/orca/build.py && \
  install -Dm644 /build/support-fins/plugins/orca/build/support_fins_orca.py /usr/local/share/orcaslicer/plugins/SupportFins/support_fins_orca.py && \
  install -m644 /build/support-fins/LICENSE /usr/local/share/orcaslicer/plugins/SupportFins/LICENSE && \
  printf "%s\n" "${SUPPORT_FINS_VERSION}" > /usr/local/share/orcaslicer/plugins/SupportFins/VERSION && \
  echo "**** install bundled plugin dependencies ****" && \
  python3 -c 'import pathlib,tomllib; text=pathlib.Path("/usr/local/share/orcaslicer/plugins/SupportFins/support_fins_orca.py").read_text().split("# /// script",1)[1].split("# ///",1)[0]; metadata=tomllib.loads("\n".join(line[2:] for line in text.splitlines() if line.startswith("# "))); print("\n".join(metadata.get("dependencies",[])))' > /build/plugin-requirements.txt && \
  PYTHON_ABI=$(LD_LIBRARY_PATH=/opt/orcaslicer/lib/python/lib /opt/orcaslicer/lib/python/bin/python3 -c 'import sys; print(f"cp{sys.version_info.major}{sys.version_info.minor}")') && \
  mkdir -p /usr/local/share/orcaslicer/python && \
  printf "%s\n" "${PYTHON_ABI}" > /usr/local/share/orcaslicer/python/ABI && \
  LD_LIBRARY_PATH=/opt/orcaslicer/lib/python/lib /opt/orcaslicer/resources/tools/uv/uv pip install \
    --python /opt/orcaslicer/lib/python/bin/python3 --no-python-downloads \
    --target "/usr/local/share/orcaslicer/python/${PYTHON_ABI}" -r /build/plugin-requirements.txt && \
  install -m644 /build/plugin-requirements.txt /usr/local/share/orcaslicer/plugins/SupportFins/requirements.txt && \
  sed -i 's/^# dependencies = .*/# dependencies = []/' /usr/local/share/orcaslicer/plugins/SupportFins/support_fins_orca.py && \
  sed -i '/^    import numpy as np$/a\    import numpy.ma\n    import numpy.linalg' /usr/local/share/orcaslicer/plugins/SupportFins/support_fins_orca.py && \
  rm -rf /build/support-fins /build/esbuild /build/support-fins.tar.gz /build/esbuild.tar.gz /build/plugin-requirements.txt && \
  localedef -i en_GB -f UTF-8 en_GB.UTF-8 && \
  chmod +x /opt/orcaslicer/libexec/orca-slicer-env && \
  echo "**** configure orcaslicer window decorations ****" && \
  sed -i '/<\/windowRules>/i\    <windowRule identifier="*orca*slicer*" type="normal" serverDecoration="no" />' /defaults/labwc.xml && \
  printf "Linuxserver.io version: ${VERSION}\nBuild-date: ${BUILD_DATE}" > /build_version && \
  echo "**** cleanup ****" && \
  apt-get autoclean && \
  rm -rf \
    /config/.cache \
    /config/.launchpadlib \
    /var/lib/apt/lists/* \
    /var/tmp/* \
    /tmp/*

# add local files
COPY /root /

# ports and volumes
EXPOSE 3001
VOLUME /config /data/orcaslicer
