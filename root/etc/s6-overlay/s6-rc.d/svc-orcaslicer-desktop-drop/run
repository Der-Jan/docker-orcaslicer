#!/usr/bin/with-contenv bash
# shellcheck shell=bash

if [[ "${PIXELFLUX_WAYLAND,,}" != "true" ]]; then
    echo "[orcaslicer-desktop-drop] Disabled in X11 mode."
    exec sleep infinity
fi

export HOME=/config
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/config/.XDG}"
export WAYLAND_DISPLAY=wayland-0
directory="${FILE_MANAGER_PATH:-/config/Desktop}"
s6-setuidgid abc mkdir -p "${directory}" || exit 1

echo "[orcaslicer-desktop-drop] Waiting for the application compositor."
while [[ ! -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]]; do
    sleep 1
done

exec s6-setuidgid abc /usr/bin/python3 /usr/local/libexec/watch-desktop.py \
    --directory "${directory}" --helper /usr/local/libexec/wayland-file-drop
