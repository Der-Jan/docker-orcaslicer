#!/usr/bin/with-contenv bash
# shellcheck shell=bash

plugin_dir="${XDG_CONFIG_HOME:-/config/.config}/OrcaSlicer/orca_plugins/SupportFins"
if [[ ! -e "${plugin_dir}" ]]; then
    s6-setuidgid abc mkdir -p "${plugin_dir%/*}" || exit 1
    s6-setuidgid abc cp -R /defaults/support-fins "${plugin_dir}" || exit 1
    echo "[orcaslicer-plugins] Installed Support Fins. Enable it in OrcaSlicer's Plugins dialog."
fi
